# Copy to .env (git-ignored) for the "local" profile. Spring reads it as KEY=VALUE properties: no quotes.

# Either a local PostgreSQL install...
CLOUDFORGE_DB_URL=jdbc:postgresql://localhost:5432/cloudforge
CLOUDFORGE_DB_USERNAME=cloudforge
CLOUDFORGE_DB_PASSWORD=change-me-local-only
# ...or `docker compose up -d` (compose.yaml), which uses the three values above as its defaults.
# Note: docker compose expands "$" in .env values; avoid "$" in the password if you use compose.

# Generate with: openssl rand -base64 32
CLOUDFORGE_JWT_SECRET=

# Optional, first start only: creates the first platform administrator.
CLOUDFORGE_BOOTSTRAP_ADMIN_EMAIL=
CLOUDFORGE_BOOTSTRAP_ADMIN_PASSWORD=
CLOUDFORGE_BOOTSTRAP_ADMIN_DISPLAY_NAME=
