# Everything prefixed with VITE_ is compiled into the browser bundle and is PUBLIC. Never put secrets here.

# Base path of the CloudForge API. Keep it relative: the SPA and the API share one origin
# (Vite proxy in development, reverse proxy in deployment).
VITE_API_BASE_URL=/api

# Dev server only (not exposed to the browser): where the Vite proxy forwards /api.
CLOUDFORGE_BACKEND_URL=http://localhost:8080
